@page "/admin/expenses"
@rendermode InteractiveServer

@using ExpenseTracker.Data
@using ExpenseTracker.Models
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore

@inject ApplicationDbContext Db
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Admin - Expenses</PageTitle>

<div class="admin-expenses-container">

    <!-- ───────────────────────── Page Header ───────────────────────── -->
    <div class="page-header">
        <div class="page-header-left">
            <h1 class="page-title">
                <span class="page-title-icon">💸</span>
                Expenses Management
            </h1>
            <p class="page-subtitle">View, filter, and manage all user expenses</p>
        </div>
        <div class="summary-badges">
            <div class="summary-badge">
                <span class="badge-value">@filteredExpenses.Count</span>
                <span class="badge-label">Filtered Expenses</span>
            </div>
            <div class="summary-badge summary-badge-accent">
                <span class="badge-value">@filteredExpenses.Sum(e => e.Amount).ToString("C")</span>
                <span class="badge-label">Total Amount</span>
            </div>
            <div class="summary-badge summary-badge-muted">
                <span class="badge-value">@allExpenses.Count</span>
                <span class="badge-label">All Expenses</span>
            </div>
        </div>
    </div>

    <!-- ───────────────────────── Filter Bar ────────────────────────── -->
    <div class="filter-card">
        <div class="filter-grid">

            <div class="filter-group">
                <label class="filter-label">🔍 Search by Title</label>
                <input class="filter-input"
                       type="text"
                       placeholder="Search expenses..."
                       @bind="searchText"
                       @bind:event="oninput"
                       @oninput="OnFilterChanged" />
            </div>

            <div class="filter-group">
                <label class="filter-label">🏷️ Category</label>
                <select class="filter-input" @bind="selectedCategoryId" @bind:after="FilterExpenses">
                    <option value="0">All Categories</option>
                    @foreach (var cat in categoriesDict.Values)
                    {
                        <option value="@cat.Id">@(cat.Icon != null ? cat.Icon + " " : "")@cat.Name</option>
                    }
                </select>
            </div>

            <div class="filter-group">
                <label class="filter-label">📅 From Date</label>
                <input class="filter-input"
                       type="date"
                       @bind="fromDate"
                       @bind:after="FilterExpenses" />
            </div>

            <div class="filter-group">
                <label class="filter-label">📅 To Date</label>
                <input class="filter-input"
                       type="date"
                       @bind="toDate"
                       @bind:after="FilterExpenses" />
            </div>

        </div>

        <div class="filter-actions">
            <button class="btn-clear" @onclick="ClearFilters">
                ✕ Clear Filters
            </button>
        </div>
    </div>

    <!-- ───────────────────────── Expenses Table ────────────────────── -->
    @if (isLoading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading expenses...</p>
        </div>
    }
    else if (!pagedExpenses.Any())
    {
        <div class="empty-state">
            <span class="empty-icon">🗂️</span>
            <h3>No Expenses Found</h3>
            <p>@(allExpenses.Count == 0 ? "There are no expenses recorded yet." : "No expenses match the current filters.")</p>
        </div>
    }
    else
    {
        <div class="table-card">
            <div class="table-wrapper">
                <table class="expenses-table">
                    <thead>
                        <tr>
                            <th class="col-num">#</th>
                            <th class="col-title">Title</th>
                            <th class="col-amount">Amount</th>
                            <th class="col-category">Category</th>
                            <th class="col-user">User</th>
                            <th class="col-date">Date</th>
                            <th class="col-actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int rowStart = (currentPage - 1) * PageSize; }
                        @foreach (var (expense, idx) in pagedExpenses.Select((e, i) => (e, i)))
                        {
                            <tr class="@(confirmDeleteId == expense.Id ? "row-confirm-active" : "")">
                                <td class="col-num">
                                    <span class="row-num">@(rowStart + idx + 1)</span>
                                </td>
                                <td class="col-title">
                                    <div class="title-cell">
                                        <span class="expense-title">@expense.Title</span>
                                        @if (!string.IsNullOrWhiteSpace(expense.Notes))
                                        {
                                            <span class="notes-preview" title="@expense.Notes">📝</span>
                                        }
                                    </div>
                                </td>
                                <td class="col-amount">
                                    <span class="amount-value">@expense.Amount.ToString("C")</span>
                                </td>
                                <td class="col-category">
                                    @if (expense.CategoryId.HasValue && categoriesDict.TryGetValue(expense.CategoryId.Value, out var cat))
                                    {
                                        <span class="category-badge">
                                            @if (!string.IsNullOrWhiteSpace(cat.Icon))
                                            {
                                                <span>@cat.Icon</span>
                                            }
                                            @cat.Name
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="category-badge category-none">Uncategorized</span>
                                    }
                                </td>
                                <td class="col-user">
                                    @if (usersDict.TryGetValue(expense.UserId, out var user))
                                    {
                                        <span class="user-email" title="@user.FullName">@user.Email</span>
                                    }
                                    else
                                    {
                                        <span class="user-unknown">Unknown</span>
                                    }
                                </td>
                                <td class="col-date">
                                    <span class="date-value">@expense.Date.ToString("MMM dd, yyyy")</span>
                                </td>
                                <td class="col-actions">
                                    @if (confirmDeleteId == expense.Id)
                                    {
                                        <!-- Inline confirmation row -->
                                        <div class="confirm-inline">
                                            <span class="confirm-text">Delete?</span>
                                            <button class="btn-confirm-yes" @onclick="() => ConfirmDelete(expense.Id)">
                                                ✓ Yes
                                            </button>
                                            <button class="btn-confirm-no" @onclick="CancelDelete">
                                                ✕ No
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="btn-delete" @onclick="() => RequestDelete(expense.Id)" title="Delete expense">
                                            🗑️ Delete
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- ───────────────────── Pagination ──────────────────── -->
            @if (totalPages > 1)
            {
                <div class="pagination-bar">
                    <button class="page-btn"
                            disabled="@(currentPage == 1)"
                            @onclick="PreviousPage">
                        ← Previous
                    </button>

                    <div class="page-info">
                        <span class="page-current">Page @currentPage</span>
                        <span class="page-sep">of</span>
                        <span class="page-total">@totalPages</span>
                        <span class="page-records">
                            (@(Math.Min((currentPage - 1) * PageSize + 1, filteredExpenses.Count))–@(Math.Min(currentPage * PageSize, filteredExpenses.Count)) of @filteredExpenses.Count)
                        </span>
                    </div>

                    <button class="page-btn"
                            disabled="@(currentPage == totalPages)"
                            @onclick="NextPage">
                        Next →
                    </button>
                </div>
            }
            else
            {
                <div class="pagination-bar pagination-single">
                    <span class="page-records-single">Showing @filteredExpenses.Count expense@(filteredExpenses.Count == 1 ? "" : "s")</span>
                </div>
            }
        </div>
    }

</div>

<!-- ═══════════════════════ Scoped Styles ═══════════════════════════ -->
<style>

