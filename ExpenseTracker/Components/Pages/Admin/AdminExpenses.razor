        .page-header { flex-direction: column; }
        .summary-badges { justify-content: flex-start; }
        .filter-grid { grid-template-columns: 1fr 1fr; }
    }

    @@media (max-width: 480px) {
        .filter-grid { grid-template-columns: 1fr; }
        .summary-badges { gap: 0.5rem; }
    }

</style>

@code {

    // ── Constants ──────────────────────────────────────────────────────
    private const int PageSize = 15;

    // ── State ──────────────────────────────────────────────────────────
    private bool isLoading = true;

    private List<Expense> allExpenses = new();
    private List<Expense> filteredExpenses = new();
    private List<Expense> pagedExpenses = new();

    private Dictionary<int, Category> categoriesDict = new();
    private Dictionary<string, ApplicationUser> usersDict = new();

    // Filters
    private string searchText = string.Empty;
    private int selectedCategoryId = 0;   // 0 = all
    private DateTime? fromDate;
    private DateTime? toDate;

    // Pagination
    private int currentPage = 1;
    private int totalPages = 1;

    // Delete confirmation
    private int? confirmDeleteId = null;

    // ── Lifecycle ──────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;

        // Load all expenses (no tracking needed for display)
        allExpenses = await Db.Expenses
            .AsNoTracking()
            .OrderByDescending(e => e.Date)
            .ToListAsync();

        // Load categories into dictionary
        var categories = await Db.Categories.AsNoTracking().ToListAsync();
        categoriesDict = categories.ToDictionary(c => c.Id);

        // Load users into dictionary via UserManager
        var users = await UserManager.Users.AsNoTracking().ToListAsync();
        usersDict = users.ToDictionary(u => u.Id);

        isLoading = false;

        FilterExpenses();
    }

    // ── Filtering ──────────────────────────────────────────────────────
    private void OnFilterChanged(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? string.Empty;
        FilterExpenses();
    }

    private void FilterExpenses()
    {
        var query = allExpenses.AsEnumerable();

        // Title search
        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var term = searchText.Trim().ToLowerInvariant();
            query = query.Where(e => e.Title.ToLowerInvariant().Contains(term));
        }

        // Category filter
        if (selectedCategoryId != 0)
        {
            query = query.Where(e => e.CategoryId == selectedCategoryId);
        }

        // Date range
        if (fromDate.HasValue)
        {
            query = query.Where(e => e.Date.Date >= fromDate.Value.Date);
        }

        if (toDate.HasValue)
        {
            query = query.Where(e => e.Date.Date <= toDate.Value.Date);
        }

        filteredExpenses = query.ToList();
        currentPage = 1;
        confirmDeleteId = null;

        UpdatePaging();
    }

    private void ClearFilters()
    {
        searchText = string.Empty;
        selectedCategoryId = 0;
        fromDate = null;
        toDate = null;
        FilterExpenses();
    }

    // ── Pagination ─────────────────────────────────────────────────────
    private void UpdatePaging()
    {
        totalPages = Math.Max(1, (int)Math.Ceiling(filteredExpenses.Count / (double)PageSize));
        currentPage = Math.Clamp(currentPage, 1, totalPages);

        pagedExpenses = filteredExpenses
            .Skip((currentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();
    }

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            confirmDeleteId = null;
            UpdatePaging();
        }
    }

    private void NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            confirmDeleteId = null;
            UpdatePaging();
        }
    }

    // ── Delete ─────────────────────────────────────────────────────────
    private void RequestDelete(int expenseId)
    {
        confirmDeleteId = expenseId;
    }

    private void CancelDelete()
    {
        confirmDeleteId = null;
    }

    private async Task ConfirmDelete(int expenseId)
    {
        var expense = await Db.Expenses.FindAsync(expenseId);
        if (expense is not null)
        {
            Db.Expenses.Remove(expense);
            await Db.SaveChangesAsync();
        }

        confirmDeleteId = null;

        // Refresh in-memory list
        allExpenses.RemoveAll(e => e.Id == expenseId);
        FilterExpenses();
    }
}
