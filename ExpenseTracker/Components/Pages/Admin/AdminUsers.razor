@page "/admin/users"
@rendermode InteractiveServer

@using ExpenseTracker.Data
@using ExpenseTracker.Models
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore

@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext Db

<PageTitle>Admin - Users</PageTitle>

<div class="au-container">
    <div class="au-header">
        <div>
            <h1 class="au-title">👥 User Management</h1>
            <p class="au-subtitle">View and manage all registered users</p>
        </div>
        <a href="/admin" class="au-back-btn">← Back to Dashboard</a>
    </div>

    <!-- Search Bar -->
    <div class="au-search-bar">
        <input class="au-search-input"
               value="@searchTerm"
               @oninput="OnSearchInput"
               placeholder="🔍 Search by name or email..." />
    </div>

    @if (isLoading)
    {
        <div class="au-loading">
            <div class="au-spinner"></div>
            <p>Loading users...</p>
        </div>
    }
    else
    {
        <!-- Users Table -->
        <div class="au-card">
            <div class="au-table-wrap">
                <table class="au-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>User</th>
                            <th>Email</th>
                            <th>Joined Date</th>
                            <th>Expenses</th>
                            <th>Total Spent</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (filteredUsers.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="au-empty">No users found matching "@searchTerm"</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var (user, index) in filteredUsers.Select((u, i) => (u, i + 1)))
                            {
                                var stats = expenseStats.TryGetValue(user.Id, out var s) ? s : (Count: 0, Total: 0m);
                                <tr>
                                    <td class="au-row-num">@index</td>
                                    <td>
                                        <div class="au-user-cell">
                                            <div class="au-avatar" style="background: @GetAvatarColor(user.Id)">
                                                @GetInitials(user.FullName, user.Email)
                                            </div>
                                            <span class="au-fullname">@(user.FullName ?? "N/A")</span>
                                        </div>
                                    </td>
                                    <td class="au-email">@user.Email</td>
                                    <td>@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        @if (stats.Count > 0)
                                        {
                                            <span class="au-badge au-badge-blue">@stats.Count</span>
                                        }
                                        else
                                        {
                                            <span class="au-badge au-badge-grey">0</span>
                                        }
                                    </td>
                                    <td class="au-total-spent">
                                        @if (stats.Total > 0)
                                        {
                                            <strong>@stats.Total.ToString("C2")</strong>
                                        }
                                        else
                                        {
                                            <span class="au-zero">$0.00</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="/admin/users/@user.Id" class="au-view-btn">👁 View</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Summary Footer -->
        <div class="au-summary">
            <div class="au-summary-item">
                <span class="au-summary-value">@allUsers.Count</span>
                <span class="au-summary-label">Total Users</span>
            </div>
            <div class="au-summary-item">
                <span class="au-summary-value">@filteredUsers.Count</span>
                <span class="au-summary-label">Showing</span>
            </div>
            <div class="au-summary-item">
                <span class="au-summary-value">@allExpenseCount</span>
                <span class="au-summary-label">Total Expenses Recorded</span>
            </div>
            <div class="au-summary-item">
                <span class="au-summary-value">@allTotalSpent.ToString("C2")</span>
                <span class="au-summary-label">Platform Total Spent</span>
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private string searchTerm = string.Empty;

    private List<ApplicationUser> allUsers = new();
    private List<ApplicationUser> filteredUsers = new();
    private Dictionary<string, (int Count, decimal Total)> expenseStats = new();

    private int allExpenseCount;
    private decimal allTotalSpent;

    protected override async Task OnInitializedAsync()
    {
        allUsers = await UserManager.Users.OrderBy(u => u.CreatedAt).ToListAsync();
        var expenses = await Db.Expenses.ToListAsync();

        allExpenseCount = expenses.Count;
        allTotalSpent = expenses.Sum(e => e.Amount);

        expenseStats = expenses
            .GroupBy(e => e.UserId)
            .ToDictionary(
                g => g.Key,
                g => (Count: g.Count(), Total: g.Sum(e => e.Amount))
            );

        filteredUsers = allUsers.ToList();
        isLoading = false;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredUsers = allUsers.ToList();
        }
        else
        {
            var term = searchTerm.Trim().ToLower();
            filteredUsers = allUsers
                .Where(u =>
                    (u.Email ?? "").ToLower().Contains(term) ||
                    (u.FullName ?? "").ToLower().Contains(term))
                .ToList();
        }
    }

    private static string GetInitials(string? fullName, string? email)
    {
        if (!string.IsNullOrWhiteSpace(fullName))
        {
            var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
            return parts.Length >= 2
                ? $"{parts[0][0]}{parts[1][0]}".ToUpper()
                : fullName[..Math.Min(2, fullName.Length)].ToUpper();
        }
        if (!string.IsNullOrWhiteSpace(email))
            return email[..Math.Min(2, email.Length)].ToUpper();
        return "??";
    }

    private static string GetAvatarColor(string userId)
    {
        var colors = new[] { "#052767", "#3a0647", "#065f46", "#92400e", "#1e3a8a", "#6b21a8" };
        var hash = Math.Abs(userId.GetHashCode()) % colors.Length;
        return colors[hash];
    }
}

<style>
    .au-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 1rem;
        font-family: 'Segoe UI', sans-serif;
    }

    .au-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .au-title {
        font-size: 1.8rem;
        font-weight: 700;
        color: #052767;
        margin: 0 0 0.25rem;
    }

    .au-subtitle {
        color: #6c757d;
        margin: 0;
        font-size: 0.95rem;
    }

    .au-back-btn {
        padding: 0.45rem 1rem;
        background: #f1f5fb;
        color: #052767;
        border-radius: 8px;
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 500;
        border: 1px solid #d0daea;
    }

    .au-back-btn:hover { background: #e0e7f0; text-decoration: none; }

    /* Search */
    .au-search-bar {
        margin-bottom: 1.25rem;
    }

    .au-search-input {
        width: 100%;
        max-width: 420px;
        padding: 0.6rem 1rem;
        border: 1px solid #d0daea;
        border-radius: 8px;
        font-size: 0.95rem;
        outline: none;
        transition: border-color 0.2s;
    }

    .au-search-input:focus { border-color: #052767; box-shadow: 0 0 0 3px rgba(5,39,103,0.1); }

    /* Loading */
    .au-loading {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 3rem;
        color: #6c757d;
    }

    .au-spinner {
        width: 40px;
        height: 40px;
        border: 4px solid #e0e7ff;
        border-top-color: #052767;
        border-radius: 50%;
        animation: au-spin 0.8s linear infinite;
        margin-bottom: 1rem;
    }

    @@keyframes au-spin { to { transform: rotate(360deg); } }

    /* Card & Table */
    .au-card {
        background: white;
        border-radius: 14px;
        box-shadow: 0 2px 12px rgba(5,39,103,0.1);
        overflow: hidden;
        margin-bottom: 1.5rem;
    }

    .au-table-wrap { overflow-x: auto; }

    .au-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.875rem;
    }

    .au-table th {
        background: #f1f5fb;
        color: #052767;
        font-weight: 600;
        padding: 0.75rem 1rem;
        text-align: left;
        border-bottom: 2px solid #d0daea;
    }

    .au-table td {
        padding: 0.7rem 1rem;
        border-bottom: 1px solid #f0f4f9;
        color: #374151;
        vertical-align: middle;
    }

    .au-table tbody tr:hover { background: #f8faff; }
    .au-table tbody tr:last-child td { border-bottom: none; }

    .au-row-num { color: #9ca3af; font-size: 0.8rem; }

    .au-user-cell {
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .au-avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 0.75rem;
        font-weight: 700;
        flex-shrink: 0;
    }

    .au-fullname { font-weight: 500; color: #1f2937; }
    .au-email { color: #6c757d; font-size: 0.85rem; }

    .au-badge {
        display: inline-block;
        padding: 0.2rem 0.65rem;
        border-radius: 12px;
        font-size: 0.78rem;
        font-weight: 600;
    }

    .au-badge-blue { background: #dbeafe; color: #1d4ed8; }
    .au-badge-grey { background: #f3f4f6; color: #9ca3af; }

    .au-total-spent strong { color: #052767; }
    .au-zero { color: #9ca3af; }

    .au-view-btn {
        padding: 0.3rem 0.8rem;
        background: #052767;
        color: white;
        border-radius: 6px;
        font-size: 0.8rem;
        text-decoration: none;
        white-space: nowrap;
    }

    .au-view-btn:hover { background: #1a4fa0; color: white; text-decoration: none; }

    .au-empty {
        text-align: center;
        padding: 2rem;
        color: #9ca3af;
        font-style: italic;
    }

    /* Summary */
    .au-summary {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 1rem;
    }

    .au-summary-item {
        background: white;
        border-radius: 12px;
        padding: 1rem 1.25rem;
        box-shadow: 0 2px 8px rgba(5,39,103,0.08);
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
    }

    .au-summary-value {
        font-size: 1.4rem;
        font-weight: 700;
        color: #052767;
    }

    .au-summary-label {
        font-size: 0.78rem;
        color: #6c757d;
    }
</style>
